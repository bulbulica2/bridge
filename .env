# Base URL of bridge_backend (Laravel + Sanctum SPA auth).
# Use "localhost" (not 127.0.0.1) so the backend's cookies are shared with
# the dev server at http://localhost:3000 — cookies are scoped by host, not port.
VITE_API_BASE_URL=http://localhost:8000

# Laravel Reverb (websockets) for live table updates; match REVERB_APP_KEY,
# REVERB_HOST, REVERB_PORT and REVERB_SCHEME in bridge_backend's .env.
# See bridge_docs/backend/RUNNING.md (Realtime) for starting Reverb.
VITE_REVERB_APP_KEY=bridge-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
